# ===========================================
# ETSOPY Platform - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# Production deploy appends REGISTRY_IMAGE and IMAGE_TAG automatically.

# ---- PostgreSQL ----
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=etsopy
DB_PASSWORD=changeme_db_password

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=etsopy
RABBITMQ_PASSWORD=changeme_rabbit_password

# ---- Elasticsearch ----
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ---- MinIO (S3-compatible storage) ----
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_password

# ---- JWT ----
JWT_SECRET=changeme_jwt_secret_key_at_least_256_bits_long_for_hs256
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_ISSUER_URI=https://etsopy.kseoni.ch

# ---- Eureka ----
EUREKA_URL=http://eureka-server:8761/eureka/

# ---- API Gateway ----
API_GATEWAY_PORT=8080

# ---- Service Ports (host mapping) ----
CORE_SERVICE_PORT=8001
PROJECT_SERVICE_PORT=8002
EVENT_SERVICE_PORT=8003
PORTFOLIO_SERVICE_PORT=8004
ANALYTICS_SERVICE_PORT=8005
RATING_SERVICE_PORT=8006
PARTNER_SERVICE_PORT=8007
ADMIN_SERVICE_PORT=8008
DOCUMENT_SERVICE_PORT=8009

# ---- Grafana ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana_password

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=docker
